@page "/projects"

<PageTitle>Projects | Nazmul Hussain</PageTitle>

<header class="projects-hero">
    <p class="projects-eyebrow">Projects</p>
    <h1>Work that demonstrates how I turn ideas into software</h1>

    <p class="projects-introduction">
        RecordShop and Calico demonstrate my experience building full-stack
        applications independently and through collaborative team development.
    </p>
</header>

<section class="projects-list" aria-labelledby="selected-projects-title">
    <div class="projects-section-heading">
        <p class="projects-section-label">Selected work</p>
        <h2 id="selected-projects-title">
            Projects built independently and collaboratively
        </h2>
    </div>

    <div class="projects-grid">
        <ProjectCard
            Title="RecordShop"
            ProjectType="Solo project"
            Summary="A full-stack record catalogue demonstrating layered API design, CRUD operations, search and automated backend testing."
            DetailUrl="/projects/recordshop"
            Technologies="@(new[] { "C#", "ASP.NET Core", "Blazor", "Entity Framework Core", "SQL Server", "NUnit" })"
        />

        <ProjectCard
            Title="Calico"
            ProjectType="Group project"
            Summary="A collaborative full-stack LoFi music and productivity platform featuring authentication, playlists, project tracking and task timers."
            DetailUrl="/projects/calico"
            Technologies="@(new[] { "C#", "ASP.NET Core", "Blazor", "Entity Framework Core", "Supabase", "YouTube API" })"
        />
    </div>
</section>

<section class="project-capabilities" aria-labelledby="capabilities-title">
    <div class="projects-section-heading">
        <p class="projects-section-label">Across my work</p>
        <h2 id="capabilities-title">What these projects demonstrate</h2>
    </div>

    <ul class="capabilities-list">
        <li>
            <h3>Full-stack development</h3>
            <p>Building Blazor interfaces that communicate with ASP.NET Core APIs and relational databases.</p>
        </li>
        <li>
            <h3>API design</h3>
            <p>Designing structured endpoints with controllers, services and repositories separated into clear layers.</p>
        </li>
        <li>
            <h3>Data management</h3>
            <p>Using Entity Framework Core to store, retrieve and manage relational application data.</p>
        </li>
        <li>
            <h3>Testing and collaboration</h3>
            <p>Writing automated tests and collaborating through pair programming, Git reviews and team feedback.</p>
        </li>
    </ul>
</section>

<section class="projects-cta" aria-labelledby="projects-cta-title">
    <p class="projects-section-label">Get in touch</p>
    <h2 id="projects-cta-title">Interested in how I could contribute?</h2>

    <p class="projects-cta-summary">
        I’m looking for a junior C#/.NET development opportunity where I can
        contribute my full-stack skills, learn from an experienced team and continue growing.
    </p>

    <NavLink class="projects-contact-link" href="/contact">
        Contact me
    </NavLink>
</section>
