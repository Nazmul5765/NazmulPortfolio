@page "/contact"

<PageTitle>Contact | Nazmul Hussain</PageTitle>

<section class="contact-hero" aria-labelledby="contact-title">
    <p class="contact-section-label">Get in touch</p>

    <h1 id="contact-title">
        Let's work together
    </h1>

    <p class="contact-introduction">
        I’m looking for a junior C#/.NET opportunity where I can contribute my
        backend and full-stack skills, learn and continue developing professionally.
    </p>
</section>

<section class="contact-methods" aria-labelledby="contact-methods-title">
    <div class="contact-methods-heading">
        <p class="contact-section-label">Contact details</p>
        <h2 id="contact-methods-title">Choose how to reach me</h2>
    </div>

    <div class="contact-methods-grid">
        <article class="contact-card">
            <p class="contact-card-label">LinkedIn</p>
            <h3>Connect professionally</h3>

            <p>
                View my professional profile and connect with me on LinkedIn.
            </p>

            <a class="contact-card-link"
               href="https://www.linkedin.com/in/nazmul-hussain/"
               target="_blank"
               rel="noopener noreferrer">
                View LinkedIn profile →
            </a>
        </article>

        <article class="contact-card">
            <p class="contact-card-label">GitHub</p>
            <h3>Explore my code</h3>

            <p>
                Browse my repositories and see the software projects I have been building.
            </p>

            <a class="contact-card-link"
               href="https://github.com/Nazmul5765"
               target="_blank"
               rel="noopener noreferrer">
                View GitHub profile →
            </a>
        </article>

        <article class="contact-card">
            <p class="contact-card-label">Email</p>
            <h3>Send me a message</h3>

            <p>
                Contact me directly to discuss junior C#/.NET roles and development opportunities.
            </p>

            <a class="contact-card-link"
               href="mailto:nazmulhussain@hotmail.co.uk">
                Send an email →
            </a>
        </article>
    </div>
</section>

<section class="contact-availability" aria-labelledby="availability-title">
    <p class="contact-section-label">Availability</p>

    <h2 id="availability-title">
        Open to junior C#/.NET development opportunities
    </h2>

    <p>
        I’m particularly interested in backend-focused opportunities where I can
        contribute to a development team, gain commercial experience and continue learning.
    </p>
</section>
