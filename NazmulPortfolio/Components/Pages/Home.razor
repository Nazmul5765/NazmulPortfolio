@page "/"

<PageTitle>Home</PageTitle>

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
        <p class="hero-eyebrow">Hello, I'm</p>
        <h1 id="hero-title" class="hero-title">Nazmul Hussain</h1>
        <p class="hero-role">Junior C#/.NET Developer</p>
        <p class="hero-summary">I build reliable web applications using C#, ASP.NET Core and Blazor.</p>
        <div class="hero-actions">
            <NavLink class="button button-primary" href="/projects">
                View my work
            </NavLink>
            <NavLink class="button button-secondary" href="/contact">
                Contact me
            </NavLink>
        </div>
    </div>
</section>

<section class="about-preview" aria-labelledby="about-preview-title">
    <div class="section-heading">
        <p class="section-label">About</p>
        <h2 id="about-preview-title">Building my career in software development</h2>
    </div>
    <div class="about-preview-content">
        <p>
            I recently completed the Northcoders Enterprise Engineering Bootcamp,
            where I developed full-stack applications using C#, ASP.NET Core and Blazor.
        </p>
        <NavLink class="text-link" href="/about">More about me</NavLink>
    </div>
</section>

<section class="skills-preview" aria-labelledby="skills-preview-title">
    <div class="section-heading">
        <p class="section-label">Skills</p>
        <h2 id="skills-preview-title">Technologies I work with</h2>
    </div>
    <p class="skills-intro">My current toolkit focuses on building and testing full-stack applications with the .NET ecosystem.</p>
    <ul class="skills-list">
        <SkillBadge Name="C#" />
        <SkillBadge Name=".NET 8" />
        <SkillBadge Name="ASP.NET Core" />
        <SkillBadge Name="Blazor" />
        <SkillBadge Name="Entity Framework Core" />
        <SkillBadge Name="SQL Server" />
        <SkillBadge Name="NUnit" />
        <SkillBadge Name="Git" />
    </ul>
</section>

<section class="featured-projects" aria-labelledby="featured-projects-title">
    <div class="section-heading">
        <p class="section-label">Projects</p>
        <h2 id="featured-projects-title">Featured work</h2>
    </div>

    <div class="projects-grid">
        <ProjectCard
            Title="RecordShop"
            ProjectType="Solo project"
            Summary="A full-stack record catalogue demonstrating layered API design, CRUD operations, search and automated backend testing."
            DetailUrl="/projects/recordshop"
            Technologies="@(new[] {"C#", "ASP.NET Core", "Blazor", "Entity Framework Core", "SQL Server", "NUnit"})"
        />
        <ProjectCard
            Title="Calico"
            ProjectType="Group project"
            Summary="A LoFi music and productivity platform with authentication, playlists, projects and task timers."
            DetailUrl="/projects/calico"
            Technologies="@(new[] {"C#", "ASP.NET Core", "Blazor", "Entity Framework Core", "Supabase", "YouTube API"})"
        />
    </div>
</section>

<section class="contact-cta" aria-labelledby="contact-cta-title">
    <div class="contact-cta-content">
        <p class="section-label">Get in touch</p>
        <h2 id="contact-cta-title">Interested in working together?</h2>
        <p class="contact-cta-summary">
            I’m currently looking for junior software development opportunities
            where I can contribute, learn and continue growing as a developer.
        </p>
        <NavLink class="button button-primary" href="/contact">
            Contact me
        </NavLink>
    </div>
</section>