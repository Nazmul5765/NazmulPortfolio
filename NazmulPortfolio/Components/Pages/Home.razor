@page "/"

<PageTitle>Junior C#/.NET Developer | Nazmul Hussain</PageTitle>

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
        <p class="hero-eyebrow">Hello, I'm</p>
        <h1 id="hero-title" class="hero-title">Nazmul Hussain</h1>
        <p class="hero-role">Junior C#/.NET Developer</p>
        <p class="hero-summary">
            I build and test full-stack web applications, with a particular interest
            in backend development using C# and ASP.NET Core.
        </p>
        <div class="hero-actions">
            <NavLink class="button button-primary" href="/projects">
                View my work
            </NavLink>
            <NavLink class="button button-secondary" href="/contact">
                Contact me
            </NavLink>
            <a class="button button-secondary"
               href="https://raw.githubusercontent.com/Nazmul5765/nazmul-cv/main/Nazmul_Hussain_CV.pdf"
               onclick="downloadFile('https://raw.githubusercontent.com/Nazmul5765/nazmul-cv/main/Nazmul_Hussain_CV.pdf', 'Nazmul_Hussain_CV.pdf'); return false;">
                Download CV
            </a>
        </div>
    </div>
</section>

<section class="about-preview" aria-labelledby="about-preview-title">
    <div class="section-heading">
        <p class="section-label">About</p>
        <h2 id="about-preview-title">Building my career in backend-focused .NET development</h2>
    </div>
    <div class="about-preview-content">
        <p>
            I completed the Northcoders Enterprise Engineering Bootcamp, where I
            developed full-stack applications independently and as part of an agile team.
        </p>
        <NavLink class="text-link" href="/about">More about me</NavLink>
    </div>
</section>

<section class="skills-preview" aria-labelledby="skills-preview-title">
    <div class="section-heading">
        <p class="section-label">Skills</p>
        <h2 id="skills-preview-title">Technologies I work with</h2>
    </div>
    <p class="skills-intro">
        My toolkit focuses on backend development, relational data, automated testing
        and connecting ASP.NET Core APIs to Blazor interfaces.
    </p>
    <ul class="skills-list">
        <SkillBadge Name="C#" />
        <SkillBadge Name=".NET 8" />
        <SkillBadge Name="ASP.NET Core" />
        <SkillBadge Name="Blazor" />
        <SkillBadge Name="Entity Framework Core" />
        <SkillBadge Name="SQL Server" />
        <SkillBadge Name="PostgreSQL" />
        <SkillBadge Name="Supabase" />
        <SkillBadge Name="NUnit" />
        <SkillBadge Name="Docker" />
        <SkillBadge Name="CI/CD (GitHub Actions)" />
        <SkillBadge Name="Git" />
    </ul>
</section>

<section class="featured-projects" aria-labelledby="featured-projects-title">
    <div class="section-heading">
        <p class="section-label">Projects</p>
        <h2 id="featured-projects-title">Featured work</h2>
    </div>

    <div class="projects-grid">
        <ProjectCard
            Title="RecordShop"
            ProjectType="Solo project"
            Summary="A solo full-stack record shop application demonstrating layered API design, test-driven development, CRUD operations and application health checks."
            DetailUrl="/projects/recordshop"
            Technologies="@(new[] {"C#", "ASP.NET Core", "Blazor", "Entity Framework Core", "SQL Server", "PostgreSQL", "NUnit"})"
        />
        <ProjectCard
            Title="Calico"
            ProjectType="Group project"
            Summary="A collaborative LoFi music and productivity platform built through pair programming, agile planning and shared full-stack development."
            DetailUrl="/projects/calico"
            Technologies="@(new[] {"C#", "ASP.NET Core", "Blazor", "Entity Framework Core", "Supabase", "YouTube API", "SQLite", "SQL Server", "NUnit"})"
        />
    </div>
</section>

<section class="contact-cta" aria-labelledby="contact-cta-title">
    <div class="contact-cta-content">
        <p class="section-label">Get in touch</p>
        <h2 id="contact-cta-title">Interested in working together?</h2>
        <p class="contact-cta-summary">
            I’m looking for a junior C#/.NET role where I can contribute to backend
            development, learn from an experienced team and continue growing as a developer.
        </p>
        <NavLink class="button button-primary" href="/contact">
            Contact me
        </NavLink>
    </div>
</section>
